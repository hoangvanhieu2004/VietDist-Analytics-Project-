/// Dữ liệu team của user; NPP do user phụ trách
role 'Truong nhom'
	modelPermission: read

	tablePermission 'Dim Employee' =
			VAR v = LOOKUPVALUE('Security User'[team], 'Security User'[email], LOWER(USERPRINCIPALNAME()))
			RETURN NOT ISBLANK(v) && 'Dim Employee'[team] = v

	tablePermission 'Dim Distributor' =
			VAR v = LOOKUPVALUE('Security User'[employee_id], 'Security User'[email], LOWER(USERPRINCIPALNAME()))
			RETURN NOT ISBLANK(v) && 'Dim Distributor'[assigned_supervisor_id] = v

	tablePermission 'Security User' = 'Security User'[email] = LOWER(USERPRINCIPALNAME())

	annotation PBI_Id = 553513fe62dd42b5886f997423575d90

