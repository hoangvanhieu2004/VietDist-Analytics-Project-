/// Bảng chứa toàn bộ measure của model
table _Measures
	lineageTag: 7806f8a4-6a52-4bb7-9451-cf4461ed8aba

	/// Doanh thu thuần (net_amount) của các dòng Delivered, chưa trừ hàng trả
	measure 'Net Sales Delivered' = SUM('Fact Sales'[net_revenue])
		formatString: #,0
		displayFolder: 01 Sales
		lineageTag: de5cd16c-b5f4-43a2-b1a5-94e87215fe1f

	measure 'Gross Sales Delivered' = CALCULATE(SUM('Fact Sales'[gross_amount]), 'Fact Sales'[is_delivered] = TRUE())
		formatString: #,0
		displayFolder: 01 Sales
		lineageTag: 40df110e-35df-4da1-9460-6cb04e0b4cbe

	measure 'Discount Amount' = CALCULATE(SUM('Fact Sales'[discount_amount]), 'Fact Sales'[is_delivered] = TRUE())
		formatString: #,0
		displayFolder: 01 Sales
		lineageTag: c7d9ac46-a10b-4246-8b45-e6cf69cb8779

	/// Giá trị hàng trả đã xử lý, ghi nhận theo kỳ return_date (A-36)
	measure 'Returns Value' = SUM('Fact Returns'[return_amount_processed])
		formatString: #,0
		displayFolder: 01 Sales
		lineageTag: ec1151a7-12d6-4c43-919f-368a162a8c64

	measure 'Returns Value (All Status)' = SUM('Fact Returns'[return_amount])
		formatString: #,0
		displayFolder: 01 Sales
		lineageTag: 90b2a02e-60a1-4a25-beab-db8ff30d96d9

	measure 'Returns Qty' = CALCULATE(SUM('Fact Returns'[return_quantity]), 'Fact Returns'[is_processed] = TRUE())
		formatString: #,0
		displayFolder: 01 Sales
		lineageTag: eaa9a92b-07ff-49ee-8cf5-279533d9266d

	/// BR-A-01: Doanh thu đã giao − hàng trả đã xử lý
	measure 'Net Revenue' = [Net Sales Delivered] - [Returns Value]
		formatString: #,0
		displayFolder: 01 Sales
		lineageTag: b6e36ea0-5d73-4c90-afc7-d2aed8315481

	measure 'Return Rate %' = DIVIDE([Returns Value], [Net Sales Delivered])
		formatString: 0.0%
		displayFolder: 01 Sales
		lineageTag: 0c110038-1964-466a-89ee-7409384e7c2a

	measure 'Quantity Sold' = CALCULATE(SUM('Fact Sales'[quantity]), 'Fact Sales'[is_delivered] = TRUE())
		formatString: #,0
		displayFolder: 01 Sales
		lineageTag: f18f952c-519a-4cb8-bfd5-eb25589d6e27

	measure Orders = CALCULATE(DISTINCTCOUNT('Fact Sales'[order_id]), 'Fact Sales'[is_delivered] = TRUE())
		formatString: #,0
		displayFolder: 01 Sales
		lineageTag: ff6f505e-5664-441f-9656-7396e0cabb6e

	/// Số KH khác nhau có dòng Delivered trong kỳ
	measure 'Active Customers' = CALCULATE(DISTINCTCOUNT('Fact Sales'[customer_id]), 'Fact Sales'[is_delivered] = TRUE())
		formatString: #,0
		displayFolder: 01 Sales
		lineageTag: 48e6789b-777b-4cd0-8b61-1bd41db97b86

	/// Ngày cuối cùng có giao dịch bán — mốc 'hôm nay' cho dự báo và các measure rolling
	measure 'Last Data Date' = CALCULATE(MAX('Fact Sales'[order_date]), REMOVEFILTERS())
		formatString: dd/mm/yyyy
		displayFolder: 01 Sales
		lineageTag: 47734f1d-e489-4d26-8e3a-abb2ff0c9141

	/// Chỉ tiêu theo phiên bản đang áp dụng cho từng tháng (is_latest). Chỉ tiêu không chia theo sản phẩm: trả về trống khi đang lọc Dim Product (A-44)
	measure 'Target (Latest)' =
			IF(
			    ISFILTERED('Dim Product'),
			    BLANK(),
			    CALCULATE(SUM('Fact Targets'[target_revenue]), 'Fact Targets'[is_latest] = TRUE())
			)
		formatString: #,0
		displayFolder: 02 Target
		lineageTag: 70cc530f-a63b-4c14-b009-7e366bc69bdc

	/// Chỉ tiêu theo kế hoạch đầu năm. Chỉ tiêu không chia theo sản phẩm: trả về trống khi đang lọc Dim Product (A-44)
	measure 'Target (Original)' =
			IF(
			    ISFILTERED('Dim Product'),
			    BLANK(),
			    CALCULATE(SUM('Fact Targets'[target_revenue]), 'Fact Targets'[is_original] = TRUE())
			)
		formatString: #,0
		displayFolder: 02 Target
		lineageTag: 380a27ba-4c20-4b27-9b90-6c7d76949ba1

	/// Chỉ tiêu theo phiên bản chọn ở slicer Plan Version; không chọn thì = Latest. Chỉ tiêu không chia theo sản phẩm: trả về trống khi đang lọc Dim Product (A-44)
	measure 'Target (Selected Version)' =
			VAR v = SELECTEDVALUE('Plan Version'[version_code])
			RETURN
			    SWITCH(
			        TRUE(),
			        ISFILTERED('Dim Product'), BLANK(),
			        ISBLANK(v), [Target (Latest)],
			        CALCULATE(SUM('Fact Targets'[target_revenue]), 'Fact Targets'[version_code] = v)
			    )
		formatString: #,0
		displayFolder: 02 Target
		lineageTag: 01366a77-949c-4579-85f5-88c3e6208338

	/// Chỉ tiêu không chia theo sản phẩm: trả về trống khi đang lọc Dim Product (A-44)
	measure 'Target Quantity (Latest)' =
			IF(
			    ISFILTERED('Dim Product'),
			    BLANK(),
			    CALCULATE(SUM('Fact Targets'[target_quantity]), 'Fact Targets'[is_latest] = TRUE())
			)
		formatString: #,0
		displayFolder: 02 Target
		lineageTag: 141410a0-c643-4d2f-b902-2d517067885a

	/// Chỉ tiêu không chia theo sản phẩm: trả về trống khi đang lọc Dim Product (A-44)
	measure 'Target New Customers (Latest)' =
			IF(
			    ISFILTERED('Dim Product'),
			    BLANK(),
			    CALCULATE(SUM('Fact Targets'[target_new_customers]), 'Fact Targets'[is_latest] = TRUE())
			)
		formatString: #,0
		displayFolder: 02 Target
		lineageTag: bfc6f693-c5be-4d6d-b6d6-019862917202

	/// Net Revenue / Target (Latest); BLANK khi target = 0
	measure 'Achieve %' = DIVIDE([Net Revenue], [Target (Latest)])
		formatString: 0.0%
		displayFolder: 02 Target
		lineageTag: 3011b5ad-1c67-4375-83aa-eb12093067d5

	measure 'Achieve % (Original)' = DIVIDE([Net Revenue], [Target (Original)])
		formatString: 0.0%
		displayFolder: 02 Target
		lineageTag: 56e71502-3aee-4655-9cba-5c86b650b0fe

	measure 'Achieve % (Selected Version)' = DIVIDE([Net Revenue], [Target (Selected Version)])
		formatString: 0.0%
		displayFolder: 02 Target
		lineageTag: 32894795-d7b3-41d7-bb40-7563cabdceea

	measure 'Gap to Target' = IF(NOT ISBLANK([Target (Latest)]), [Net Revenue] - [Target (Latest)])
		formatString: #,0
		displayFolder: 02 Target
		lineageTag: e4fd5567-8939-4873-8eaa-37d37d823f20

	/// Dùng cho định dạng có điều kiện (Field value): xanh = đạt, đỏ = không đạt
	measure 'Achieve Color' =
			VAR a = [Achieve %]
			RETURN
			    IF(ISBLANK(a), BLANK(), IF(a >= 1, "#1B7F3B", "#C62828"))
		displayFolder: 02 Target
		lineageTag: 3809cc14-1530-4d26-a487-9cc9ad8ca227

	/// Phiên bản kế hoạch đang áp dụng trong kỳ
	measure 'Applied Version' = CALCULATE(CONCATENATEX(VALUES('Fact Targets'[version_code]), 'Fact Targets'[version_code], ", "), 'Fact Targets'[is_latest] = TRUE())
		displayFolder: 02 Target
		lineageTag: 849d2a08-1440-4be0-b6dd-3f5dc7df3dd6

	/// Cùng kỳ năm trước. Năm hiện tại có 29/2 thì năm trước lấy tới 28/2 (SAMEPERIODLASTYEAR)
	measure 'Net Revenue LY' = CALCULATE([Net Revenue], SAMEPERIODLASTYEAR('Dim Date'[Date]))
		formatString: #,0
		displayFolder: 03 Time Intelligence
		lineageTag: a55b252c-0f30-4b81-b553-60e6c1439a80

	measure 'Net Revenue YoY %' =
			VAR ly = [Net Revenue LY]
			RETURN IF(NOT ISBLANK(ly), DIVIDE([Net Revenue] - ly, ly))
		formatString: 0.0%
		displayFolder: 03 Time Intelligence
		lineageTag: 9157689e-7d15-4c21-a43d-e3a1e5c89b20

	/// Luỹ kế năm dương lịch
	measure 'Net Revenue YTD' = TOTALYTD([Net Revenue], 'Dim Date'[Date])
		formatString: #,0
		displayFolder: 03 Time Intelligence
		lineageTag: 6e08f992-65dd-4259-a1b7-0af34248194c

	measure 'Net Revenue YTD LY' = CALCULATE([Net Revenue YTD], SAMEPERIODLASTYEAR('Dim Date'[Date]))
		formatString: #,0
		displayFolder: 03 Time Intelligence
		lineageTag: 890cb17f-eba8-41fb-8379-9357beadcda7

	measure 'Net Revenue YTD YoY %' =
			VAR ly = [Net Revenue YTD LY]
			RETURN IF(NOT ISBLANK(ly), DIVIDE([Net Revenue YTD] - ly, ly))
		formatString: 0.0%
		displayFolder: 03 Time Intelligence
		lineageTag: 9905d076-0050-4c57-b6d7-40b00cb87f93

	/// Luỹ kế năm tài chính (01/09 → 31/08)
	measure 'Net Revenue FYTD' = TOTALYTD([Net Revenue], 'Dim Date'[Date], "08-31")
		formatString: #,0
		displayFolder: 03 Time Intelligence
		lineageTag: a1e8fdb6-00df-4a62-b1b2-434b4b923674

	measure 'Net Revenue FYTD LY' = CALCULATE([Net Revenue FYTD], SAMEPERIODLASTYEAR('Dim Date'[Date]))
		formatString: #,0
		displayFolder: 03 Time Intelligence
		lineageTag: 26f27482-de60-4c03-b9cb-376bfbf1c9a0

	measure 'Net Revenue FYTD YoY %' =
			VAR ly = [Net Revenue FYTD LY]
			RETURN IF(NOT ISBLANK(ly), DIVIDE([Net Revenue FYTD] - ly, ly))
		formatString: 0.0%
		displayFolder: 03 Time Intelligence
		lineageTag: aa3db9c9-743c-4f52-ba64-fc34f922d091

	measure 'Target YTD (Latest)' = TOTALYTD([Target (Latest)], 'Dim Date'[Date])
		formatString: #,0
		displayFolder: 03 Time Intelligence
		lineageTag: 2caa3d8c-c9c7-4521-a89c-3d8c1595a179

	measure 'Achieve % YTD' = DIVIDE([Net Revenue YTD], [Target YTD (Latest)])
		formatString: 0.0%
		displayFolder: 03 Time Intelligence
		lineageTag: d5bb0f16-e918-4701-8be2-b0fc7bf0cc9c

	measure 'Net Revenue PM' = CALCULATE([Net Revenue], DATEADD('Dim Date'[Date], -1, MONTH))
		formatString: #,0
		displayFolder: 03 Time Intelligence
		lineageTag: 612b9f24-79f6-4136-b72f-8eca73e0beb6

	measure 'Net Revenue MoM %' =
			VAR pm = [Net Revenue PM]
			RETURN IF(NOT ISBLANK(pm), DIVIDE([Net Revenue] - pm, pm))
		formatString: 0.0%
		displayFolder: 03 Time Intelligence
		lineageTag: 9fe0cbb6-140f-42d7-9330-b137b82723fc

	/// 3 tháng gần nhất tính tới cuối kỳ đang chọn (không vượt ngày có dữ liệu cuối)
	measure 'Net Revenue L3M' =
			VAR anchor = MIN(MAX('Dim Date'[Date]), [Last Data Date])
			RETURN CALCULATE([Net Revenue], DATESINPERIOD('Dim Date'[Date], anchor, -3, MONTH))
		formatString: #,0
		displayFolder: 03 Time Intelligence
		lineageTag: 068a3dbf-00c4-408d-aad6-2865422ed5a8

	/// 3 tháng liền trước L3M
	measure 'Net Revenue P3M' =
			VAR anchor = MIN(MAX('Dim Date'[Date]), [Last Data Date])
			RETURN CALCULATE([Net Revenue], DATESINPERIOD('Dim Date'[Date], EDATE(anchor, -3), -3, MONTH))
		formatString: #,0
		displayFolder: 03 Time Intelligence
		lineageTag: d48e5ed5-310d-4c25-a668-f02f592f4951

	/// BR-A-04: xu hướng tăng / sút = L3M so với P3M
	measure 'Net Revenue Trend %' =
			VAR p = [Net Revenue P3M]
			RETURN IF(NOT ISBLANK(p), DIVIDE([Net Revenue L3M] - p, p))
		formatString: 0.0%
		displayFolder: 03 Time Intelligence
		lineageTag: b8215b1c-f02c-4e7b-9671-c6441ba389e5

	/// Ngoại suy tuyến tính: thực tế ÷ số ngày đã qua × tổng số ngày của kỳ. 'Hôm nay' = Last Data Date. Trống khi kỳ đã đóng hoặc chưa bắt đầu (A-40)
	measure 'Forecast Period End' =
			VAR PStart = MIN('Dim Date'[Date])
			VAR PEnd = MAX('Dim Date'[Date])
			VAR AsOf = [Last Data Date]
			VAR Elapsed = INT(AsOf - PStart) + 1
			VAR TotalDays = INT(PEnd - PStart) + 1
			RETURN
			    IF(
			        NOT ISBLANK(AsOf) && AsOf >= PStart && AsOf < PEnd,
			        DIVIDE([Net Revenue], Elapsed) * TotalDays
			    )
		formatString: #,0
		displayFolder: 04 Forecast
		lineageTag: 72d77d7a-594e-4173-a506-3af7cff076b8

	measure 'Forecast Achieve %' = DIVIDE([Forecast Period End], [Target (Latest)])
		formatString: 0.0%
		displayFolder: 04 Forecast
		lineageTag: 9f73a636-7b13-4632-9a4a-226f1b05ac3e

	/// Ngưỡng tin cậy 95% (BRD 3.1): dự báo ≥ 95% target là đúng hướng
	measure 'Forecast Status' =
			VAR f = [Forecast Achieve %]
			RETURN
			    IF(ISBLANK(f), BLANK(), IF(f >= 0.95, "Đúng hướng", "Có rủi ro"))
		displayFolder: 04 Forecast
		lineageTag: e5e41214-b174-4a81-a247-cf30783d0725

	/// KH có đơn Delivered đầu tiên (toàn công ty) nằm trong kỳ và có mua trong phạm vi đang lọc. Mới + Quay lại = Active (A-39)
	measure 'New Customers' =
			VAR s = MIN('Dim Date'[Date])
			VAR e = MAX('Dim Date'[Date])
			VAR inPeriod = CALCULATETABLE(VALUES('Fact Sales'[customer_id]), 'Fact Sales'[is_delivered] = TRUE())
			VAR firstDelivered =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES('Fact Sales'[customer_id]), "@first", CALCULATE(MIN('Fact Sales'[order_date]))),
			        REMOVEFILTERS(),
			        'Fact Sales'[is_delivered] = TRUE()
			    )
			RETURN
			    COUNTROWS(
			        FILTER(firstDelivered, [@first] >= s && [@first] <= e && 'Fact Sales'[customer_id] IN inPeriod)
			    )
		formatString: #,0
		displayFolder: 05 Customer & Product
		lineageTag: c08e3a23-ac31-47b1-a764-2925dfcb6e78

	/// KH active trong kỳ đã có đơn Delivered trước kỳ = Active − Mới
	measure 'Returning Customers' =
			VAR a = [Active Customers]
			RETURN IF(NOT ISBLANK(a), a - [New Customers] + 0)
		formatString: #,0
		displayFolder: 05 Customer & Product
		lineageTag: b4b0d2fb-7f88-4796-9da8-dfee7284bd8a

	/// KH có đơn Delivered cuối cùng + 90 ngày rơi vào kỳ (giả định churn = 90 ngày không mua), không tính quá Last Data Date
	measure 'Churned Customers' =
			VAR s = MIN('Dim Date'[Date])
			VAR e = MAX('Dim Date'[Date])
			VAR AsOf = [Last Data Date]
			VAR t =
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            VALUES('Fact Sales'[customer_id]),
			            "@last", CALCULATE(MAX('Fact Sales'[order_date]))
			        ),
			        'Fact Sales'[is_delivered] = TRUE(),
			        REMOVEFILTERS('Dim Date'),
			        'Dim Date'[Date] <= e
			    )
			RETURN
			    IF(
			        s > AsOf,
			        BLANK(),
			        COUNTROWS(FILTER(t, [@last] + 90 >= s && [@last] + 90 <= e && [@last] + 90 <= AsOf)) + 0
			    )
		formatString: #,0
		displayFolder: 05 Customer & Product
		lineageTag: 340c6c00-9779-48d4-be1a-2922871aa0d4

	measure 'Revenue per Customer' = DIVIDE([Net Revenue], [Active Customers])
		formatString: #,0
		displayFolder: 05 Customer & Product
		lineageTag: d039fce0-ee28-4009-b9e5-c20407e75aec

	measure 'Top N Value' = SELECTEDVALUE('Top N'[Top N], 10)
		formatString: 0
		displayFolder: 05 Customer & Product
		lineageTag: 9274de4e-6ecf-454e-a2cb-3c382e73a6f4

	measure 'Customer Rank' =
			IF(
			    ISINSCOPE('Dim Customer'[customer_name]),
			    RANKX(ALLSELECTED('Dim Customer'[customer_name]), [Net Revenue], , DESC, Dense)
			)
		formatString: 0
		displayFolder: 05 Customer & Product
		lineageTag: dff5d567-7da1-4dee-ae56-8dcf3ed11f9a

	/// Đặt làm visual filter = 1 để lấy Top N khách hàng
	measure 'Is Top N Customer' =
			VAR r = [Customer Rank]
			RETURN IF(NOT ISBLANK(r) && r <= [Top N Value], 1, 0)
		formatString: 0
		displayFolder: 05 Customer & Product
		lineageTag: 0cea9710-7d6b-44a1-8118-bf6c642f9afe

	/// NV có doanh thu Delivered lớn nhất với KH trong kỳ
	measure 'Main Salesperson' =
			VAR t =
			    FILTER(
			        ADDCOLUMNS(VALUES('Dim Employee'[full_name]), "@r", [Net Sales Delivered]),
			        [@r] > 0
			    )
			RETURN MAXX(TOPN(1, t, [@r], DESC), 'Dim Employee'[full_name])
		displayFolder: 05 Customer & Product
		lineageTag: 5fd7ea05-02df-4ad3-aafe-a49fe6d9142a

	measure 'Product Rank' =
			IF(
			    ISINSCOPE('Dim Product'[product_name]),
			    RANKX(ALLSELECTED('Dim Product'[product_name]), [Net Revenue], , DESC, Dense)
			)
		formatString: 0
		displayFolder: 05 Customer & Product
		lineageTag: 66932a44-09ff-42e0-830a-c46c740998ca

	measure 'Product Rank (Slowest)' =
			IF(
			    ISINSCOPE('Dim Product'[product_name]),
			    RANKX(ALLSELECTED('Dim Product'[product_name]), [Quantity Sold], , ASC, Dense)
			)
		formatString: 0
		displayFolder: 05 Customer & Product
		lineageTag: 76ba1d5d-e279-44f1-929e-dc47606f61aa

	measure 'Is Top N Product' =
			VAR r = [Product Rank]
			RETURN IF(NOT ISBLANK(r) && r <= [Top N Value], 1, 0)
		formatString: 0
		displayFolder: 05 Customer & Product
		lineageTag: 4fe719cb-0172-4d36-83ce-9e573406a3fc

	measure 'Is Slowest N Product' =
			VAR r = [Product Rank (Slowest)]
			RETURN IF(NOT ISBLANK(r) && r <= [Top N Value], 1, 0)
		formatString: 0
		displayFolder: 05 Customer & Product
		lineageTag: 740bd2d5-1a03-42b2-8d4c-9ce213e3d13b

	/// BR-A-03: doanh thu Delivered trong kỳ KM (is_promo, A-35)
	measure 'Net Sales Promo' = CALCULATE([Net Sales Delivered], 'Fact Sales'[is_promo] = TRUE())
		formatString: #,0
		displayFolder: 06 Promotion
		lineageTag: 923bc396-3199-4f4a-8034-aea5cb787539

	measure 'Net Sales Non-Promo' = CALCULATE([Net Sales Delivered], 'Fact Sales'[is_promo] = FALSE())
		formatString: #,0
		displayFolder: 06 Promotion
		lineageTag: ea6cf504-fe08-4fa7-903c-dcfd6c8c3969

	measure 'Promo Share %' = DIVIDE([Net Sales Promo], [Net Sales Delivered])
		formatString: 0.0%
		displayFolder: 06 Promotion
		lineageTag: 4fcbb183-b147-46d0-99b8-ff0f2376d6bc

	/// BR-B-04: doanh thu Delivered của SP thuộc chương trình, trong thời gian chạy, đúng kênh/vùng áp dụng. Chọn nhiều chương trình trùng SP + thời gian thì tổng bị đếm trùng
	measure 'Promo Program Sales' =
			SUMX(
			    FILTER(VALUES('Dim Promotion'[promotion_id]), 'Dim Promotion'[promotion_id] <> "-1"),
			    VAR st = CALCULATE(MIN('Dim Promotion'[start_date]))
			    VAR en = CALCULATE(MAX('Dim Promotion'[end_date]))
			    VAR ch = CALCULATE(MAX('Dim Promotion'[target_channel]))
			    VAR rg = CALCULATE(MAX('Dim Promotion'[target_region]))
			    VAR prods = CALCULATETABLE(VALUES('Bridge Promotion Product'[product_id]))
			    RETURN
			        CALCULATE(
			            [Net Sales Delivered],
			            TREATAS(prods, 'Dim Product'[product_id]),
			            FILTER(ALL('Dim Date'[Date]), 'Dim Date'[Date] >= st && 'Dim Date'[Date] <= en),
			            FILTER(ALL('Fact Sales'[channel]), ch = "All" || 'Fact Sales'[channel] = ch),
			            FILTER(ALL('Fact Sales'[region]), rg = "All" || 'Fact Sales'[region] = rg)
			        )
			)
		formatString: #,0
		displayFolder: 06 Promotion
		lineageTag: 8c4799be-12c7-43a1-853e-f2684916fd5f

	/// Cùng SP / kênh / vùng, trong khoảng ngay trước KM có cùng số ngày
	measure 'Promo Pre-Period Sales' =
			SUMX(
			    FILTER(VALUES('Dim Promotion'[promotion_id]), 'Dim Promotion'[promotion_id] <> "-1"),
			    VAR st = CALCULATE(MIN('Dim Promotion'[start_date]))
			    VAR en = CALCULATE(MAX('Dim Promotion'[end_date]))
			    VAR dur = INT(en - st) + 1
			    VAR ch = CALCULATE(MAX('Dim Promotion'[target_channel]))
			    VAR rg = CALCULATE(MAX('Dim Promotion'[target_region]))
			    VAR prods = CALCULATETABLE(VALUES('Bridge Promotion Product'[product_id]))
			    RETURN
			        CALCULATE(
			            [Net Sales Delivered],
			            TREATAS(prods, 'Dim Product'[product_id]),
			            FILTER(ALL('Dim Date'[Date]), 'Dim Date'[Date] >= st - dur && 'Dim Date'[Date] < st),
			            FILTER(ALL('Fact Sales'[channel]), ch = "All" || 'Fact Sales'[channel] = ch),
			            FILTER(ALL('Fact Sales'[region]), rg = "All" || 'Fact Sales'[region] = rg)
			        )
			)
		formatString: #,0
		displayFolder: 06 Promotion
		lineageTag: dd6396c6-7092-4aef-adfc-e353b9780086

	measure 'Promo Uplift %' =
			VAR pre = [Promo Pre-Period Sales]
			RETURN IF(NOT ISBLANK(pre), DIVIDE([Promo Program Sales] - pre, pre))
		formatString: 0.0%
		displayFolder: 06 Promotion
		lineageTag: a7aabed8-8021-41b4-b378-35182417ef0f

	measure 'Promo Cost' = SUM('Dim Promotion'[actual_cost_vnd])
		formatString: #,0
		displayFolder: 06 Promotion
		lineageTag: 901ff30e-27ba-4b66-a7e3-f16b8fab3bc2

	measure 'Promo Budget' = SUM('Dim Promotion'[budget_vnd])
		formatString: #,0
		displayFolder: 06 Promotion
		lineageTag: 420cd729-b22b-4673-bd28-94c34ed371e9

	/// ROI sơ bộ = (doanh số trong KM − trước KM − chi phí) / chi phí
	measure 'Promo ROI' =
			VAR cost = [Promo Cost]
			RETURN IF(cost > 0, DIVIDE([Promo Program Sales] - [Promo Pre-Period Sales] - cost, cost))
		formatString: 0.0%
		displayFolder: 06 Promotion
		lineageTag: eb978c3d-d50d-4304-93d4-2ff4467f91a8

	measure 'Distributor Orders' = DISTINCTCOUNT('Fact Distributor Orders'[order_id])
		formatString: #,0
		displayFolder: 07 Distributor
		lineageTag: 929b7f34-0b1a-46ba-9ab7-9d12cca5c8af

	/// BR-B-01 Total Order Value (gross)
	measure 'Distributor Order Value' = SUM('Fact Distributor Orders'[gross_amount])
		formatString: #,0
		displayFolder: 07 Distributor
		lineageTag: dd314d3c-0ab9-4689-8abc-8e99eb5a7d94

	measure 'Distributor Delivered Value' = SUM('Fact Distributor Orders'[delivered_amount_effective])
		formatString: #,0
		displayFolder: 07 Distributor
		lineageTag: 6e067c82-1a1e-4921-a4c5-967d94152c4b

	measure 'Qty Ordered' = SUM('Fact Distributor Orders'[qty_ordered])
		formatString: #,0
		displayFolder: 07 Distributor
		lineageTag: 2cfcd329-39f8-4d3c-8a00-12f1dbedad93

	measure 'Qty Delivered' = SUM('Fact Distributor Orders'[qty_delivered_effective])
		formatString: #,0
		displayFolder: 07 Distributor
		lineageTag: 2f7fe768-f683-4c30-a3b0-19d7db3b1936

	/// Σ qty_delivered_effective / Σ qty_ordered (A-17)
	measure 'Fill Rate %' = DIVIDE([Qty Delivered], [Qty Ordered])
		formatString: 0.0%
		displayFolder: 07 Distributor
		lineageTag: f2eabbb3-2980-46de-8b42-0030977901ad

	/// Tỷ lệ dòng giao đúng hạn trong các dòng không Cancelled (A-18)
	measure 'On-time %' =
			DIVIDE(
			    CALCULATE(COUNTROWS('Fact Distributor Orders'), 'Fact Distributor Orders'[is_ontime] = TRUE(), 'Fact Distributor Orders'[delivery_status] <> "Cancelled"),
			    CALCULATE(COUNTROWS('Fact Distributor Orders'), 'Fact Distributor Orders'[delivery_status] <> "Cancelled")
			)
		formatString: 0.0%
		displayFolder: 07 Distributor
		lineageTag: 34494384-6832-478e-9aad-edbc547950cc

	measure 'Cancelled Lines' = CALCULATE(COUNTROWS('Fact Distributor Orders'), 'Fact Distributor Orders'[delivery_status] = "Cancelled") + 0
		formatString: #,0
		displayFolder: 07 Distributor
		lineageTag: 209cfbe5-1923-4543-87c9-8d81aeec770b

	measure 'Active Distributors' = DISTINCTCOUNT('Fact Distributor Orders'[distributor_id])
		formatString: #,0
		displayFolder: 07 Distributor
		lineageTag: 3091d8bc-46cb-4598-a04e-7f9b53940a21

	/// Số NPP > 30 ngày không đặt hàng, tính tới cuối tháng cuối cùng của kỳ (mart_distributor_performance)
	measure 'Inactive Distributors' =
			VAR m = CALCULATE(MAX('Mart Distributor Performance'[month_start]))
			RETURN
			    CALCULATE(
			        COUNTROWS('Mart Distributor Performance'),
			        'Mart Distributor Performance'[inactive_alert] = TRUE(),
			        'Mart Distributor Performance'[month_start] = m
			    ) + 0
		formatString: #,0
		displayFolder: 07 Distributor
		lineageTag: 6abe1fab-b48a-4909-8768-658a26c92ab5

	measure 'Channel Mix %' = DIVIDE([Distributor Order Value], CALCULATE([Distributor Order Value], REMOVEFILTERS('Dim Distributor'[channel])))
		formatString: 0.0%
		displayFolder: 07 Distributor
		lineageTag: 395e205d-5c0b-41d1-88b6-cf2720d0b61f

	measure 'Last Distributor Order Date' = CALCULATE(MAX('Fact Distributor Orders'[order_date]), REMOVEFILTERS())
		formatString: dd/mm/yyyy
		displayFolder: 07 Distributor
		lineageTag: 0f3dce6e-9b3c-4eba-8d86-df227b74f548

	measure 'Distributor Order Value LY' = CALCULATE([Distributor Order Value], SAMEPERIODLASTYEAR('Dim Date'[Date]))
		formatString: #,0
		displayFolder: 07 Distributor
		lineageTag: 63df7c6a-c7da-4f9d-a1cf-df1b6beb0438

	measure 'Distributor Order Value YoY %' =
			VAR ly = [Distributor Order Value LY]
			RETURN IF(NOT ISBLANK(ly), DIVIDE([Distributor Order Value] - ly, ly))
		formatString: 0.0%
		displayFolder: 07 Distributor
		lineageTag: 1a0c507a-eae5-4559-9585-fd428b90138f

	measure 'Distributor Order Value L3M' =
			VAR anchor = MIN(MAX('Dim Date'[Date]), [Last Distributor Order Date])
			RETURN CALCULATE([Distributor Order Value], DATESINPERIOD('Dim Date'[Date], anchor, -3, MONTH))
		formatString: #,0
		displayFolder: 07 Distributor
		lineageTag: fd23abcc-1091-49a6-91ef-decaa313141e

	measure 'Distributor Order Value P3M' =
			VAR anchor = MIN(MAX('Dim Date'[Date]), [Last Distributor Order Date])
			RETURN CALCULATE([Distributor Order Value], DATESINPERIOD('Dim Date'[Date], EDATE(anchor, -3), -3, MONTH))
		formatString: #,0
		displayFolder: 07 Distributor
		lineageTag: 53a17e11-d63f-4a18-b371-7e69ed9c5b81

	/// BR-B-01/02: NPP tăng / giảm = L3M so với P3M
	measure 'Distributor Trend %' =
			VAR p = [Distributor Order Value P3M]
			RETURN IF(NOT ISBLANK(p), DIVIDE([Distributor Order Value L3M] - p, p))
		formatString: 0.0%
		displayFolder: 07 Distributor
		lineageTag: 3e7aef6a-a617-4b39-b08c-edc07dd5b4e1

	/// Số ngày không đặt hàng tính tới cuối tháng cuối cùng của kỳ (mart_distributor_performance)
	measure 'Days Since Last Order' =
			VAR m = CALCULATE(MAX('Mart Distributor Performance'[month_start]))
			RETURN CALCULATE(MAX('Mart Distributor Performance'[days_since_last_order]), 'Mart Distributor Performance'[month_start] = m)
		formatString: #,0
		displayFolder: 07 Distributor
		lineageTag: e166d7b7-1344-4e15-b221-6da42bd5e69c

	/// 1 = NPP > 30 ngày không đặt hàng tại cuối tháng cuối cùng của kỳ; dùng làm visual filter
	measure 'Is Inactive Distributor' =
			VAR m = CALCULATE(MAX('Mart Distributor Performance'[month_start]))
			RETURN IF(CALCULATE(COUNTROWS('Mart Distributor Performance'), 'Mart Distributor Performance'[inactive_alert] = TRUE(), 'Mart Distributor Performance'[month_start] = m) > 0, 1, 0)
		formatString: 0
		displayFolder: 07 Distributor
		lineageTag: 5f1245ad-c86f-4083-b3ff-be082f0ac9f3

	/// Chỉ tiêu không lọc phiên bản, chỉ dùng khi Fact Targets[version_code] nằm trên trục. Chỉ tiêu không chia theo sản phẩm: trả về trống khi đang lọc Dim Product (A-44)
	measure 'Target (All Versions)' = IF(ISFILTERED('Dim Product'), BLANK(), SUM('Fact Targets'[target_revenue]))
		formatString: #,0
		displayFolder: 02 Target
		lineageTag: ab8ada2f-2a87-4977-a20f-ab0605ffcb30

	/// 1 = sản phẩm thuộc chương trình KM đang chọn (slicer Dim Promotion); dùng làm visual filter
	measure 'Is Promotion Product' =
			IF(
			    COUNTROWS(INTERSECT(VALUES('Dim Product'[product_id]), VALUES('Bridge Promotion Product'[product_id]))) > 0,
			    1,
			    0
			)
		formatString: 0
		displayFolder: 06 Promotion
		lineageTag: c8b4ab97-fcc3-43ef-8873-a8c81b4f1147

	/// Dòng phạm vi dưới tiêu đề trang: các bộ lọc đang áp dụng
	measure 'Scope Text' =
			VAR yr = IF(ISFILTERED('Dim Date'[year]), "Năm " & CONCATENATEX(VALUES('Dim Date'[year]), 'Dim Date'[year], ", ", 'Dim Date'[year], ASC), "Mọi năm")
			VAR q = IF(ISFILTERED('Dim Date'[quarter]), " · Quý " & IF(COUNTROWS(VALUES('Dim Date'[quarter])) > 3, COUNTROWS(VALUES('Dim Date'[quarter])) & " giá trị", CONCATENATEX(VALUES('Dim Date'[quarter]), 'Dim Date'[quarter], ", ", 'Dim Date'[quarter], ASC)), "")
			VAR mo = IF(ISFILTERED('Dim Date'[month_name]), " · Tháng " & CONCATENATEX(VALUES('Dim Date'[month]), 'Dim Date'[month], ", ", 'Dim Date'[month], ASC), "")
			VAR rg = IF(ISFILTERED('Dim Employee'[region]), " · Vùng " & IF(COUNTROWS(VALUES('Dim Employee'[region])) > 3, COUNTROWS(VALUES('Dim Employee'[region])) & " giá trị", CONCATENATEX(VALUES('Dim Employee'[region]), 'Dim Employee'[region], ", ")), "")
			VAR tm = IF(ISFILTERED('Dim Employee'[team]), " · " & IF(COUNTROWS(VALUES('Dim Employee'[team])) > 3, COUNTROWS(VALUES('Dim Employee'[team])) & " giá trị", CONCATENATEX(VALUES('Dim Employee'[team]), 'Dim Employee'[team], ", ")), "")
			VAR em = IF(ISFILTERED('Dim Employee'[full_name]), " · NV " & IF(COUNTROWS(VALUES('Dim Employee'[full_name])) > 3, COUNTROWS(VALUES('Dim Employee'[full_name])) & " giá trị", CONCATENATEX(VALUES('Dim Employee'[full_name]), 'Dim Employee'[full_name], ", ")), "")
			VAR cat = IF(ISFILTERED('Dim Product'[category]), " · Ngành hàng " & IF(COUNTROWS(VALUES('Dim Product'[category])) > 3, COUNTROWS(VALUES('Dim Product'[category])) & " giá trị", CONCATENATEX(VALUES('Dim Product'[category]), 'Dim Product'[category], ", ")), "")
			VAR pr = IF(ISFILTERED('Dim Product'), " (chỉ tiêu không áp dụng khi lọc sản phẩm)", "")
			VAR dr = IF(ISFILTERED('Dim Distributor'[region]), " · Vùng NPP " & IF(COUNTROWS(VALUES('Dim Distributor'[region])) > 3, COUNTROWS(VALUES('Dim Distributor'[region])) & " giá trị", CONCATENATEX(VALUES('Dim Distributor'[region]), 'Dim Distributor'[region], ", ")), "")
			VAR ch = IF(ISFILTERED('Dim Distributor'[channel]), " · Kênh " & IF(COUNTROWS(VALUES('Dim Distributor'[channel])) > 3, COUNTROWS(VALUES('Dim Distributor'[channel])) & " giá trị", CONCATENATEX(VALUES('Dim Distributor'[channel]), 'Dim Distributor'[channel], ", ")), "")
			VAR ti = IF(ISFILTERED('Dim Distributor'[tier]), " · " & IF(COUNTROWS(VALUES('Dim Distributor'[tier])) > 3, COUNTROWS(VALUES('Dim Distributor'[tier])) & " giá trị", CONCATENATEX(VALUES('Dim Distributor'[tier]), 'Dim Distributor'[tier], ", ")), "")
			VAR dn = IF(ISFILTERED('Dim Distributor'[distributor_name]), " · NPP " & IF(COUNTROWS(VALUES('Dim Distributor'[distributor_name])) > 3, COUNTROWS(VALUES('Dim Distributor'[distributor_name])) & " giá trị", CONCATENATEX(VALUES('Dim Distributor'[distributor_name]), 'Dim Distributor'[distributor_name], ", ")), "")
			VAR pm = IF(ISFILTERED('Dim Promotion'[promotion_name]), " · KM " & IF(COUNTROWS(VALUES('Dim Promotion'[promotion_name])) > 3, COUNTROWS(VALUES('Dim Promotion'[promotion_name])) & " giá trị", CONCATENATEX(VALUES('Dim Promotion'[promotion_name]), 'Dim Promotion'[promotion_name], ", ")), "")
			VAR pt = IF(ISFILTERED('Dim Promotion'[promotion_type]), " · Loại KM " & IF(COUNTROWS(VALUES('Dim Promotion'[promotion_type])) > 3, COUNTROWS(VALUES('Dim Promotion'[promotion_type])) & " giá trị", CONCATENATEX(VALUES('Dim Promotion'[promotion_type]), 'Dim Promotion'[promotion_type], ", ")), "")
			VAR ps = IF(ISFILTERED('Dim Promotion'[status]), " · Trạng thái KM " & IF(COUNTROWS(VALUES('Dim Promotion'[status])) > 3, COUNTROWS(VALUES('Dim Promotion'[status])) & " giá trị", CONCATENATEX(VALUES('Dim Promotion'[status]), 'Dim Promotion'[status], ", ")), "")
			VAR pv = IF(ISFILTERED('Plan Version'[version_code]), " · So với " & IF(COUNTROWS(VALUES('Plan Version'[version_code])) > 3, COUNTROWS(VALUES('Plan Version'[version_code])) & " giá trị", CONCATENATEX(VALUES('Plan Version'[version_code]), 'Plan Version'[version_code], ", ")), "")
			RETURN "Phạm vi: " & yr & q & mo & rg & tm & em & cat & pr & dr & ch & ti & dn & pm & pt & ps & pv
		displayFolder: 08 Display
		lineageTag: 8aed7dde-9280-4589-bc23-1dc4d69aff45

	measure 'Ctx Net Revenue' =
			VAR g = [Gap to Target]
			VAR oneMonth = HASONEVALUE('Dim Date'[year]) && HASONEVALUE('Dim Date'[month])
			VAR pm = IF(oneMonth, [Net Revenue MoM %])
			RETURN
			    SWITCH(
			        TRUE(),
			        NOT ISBLANK(g), "Chênh chỉ tiêu: " & FORMAT(g / 1e9, "+#,0.0;-#,0.0") & " tỷ",
			        NOT ISBLANK(pm), "So tháng trước: " & FORMAT(pm, "+0.0%;-0.0%"),
			        "Chỉ tiêu không áp dụng cho phạm vi này"
			    )
		displayFolder: 08 Display
		lineageTag: 4d50bc51-f3e7-45ec-b22a-eb5963c3862b

	measure 'Ctx Target' =
			IF(
			    ISFILTERED('Dim Product'),
			    "Không áp dụng khi lọc sản phẩm",
			    "Kế hoạch đầu năm (v1): " & FORMAT([Target (Original)] / 1e9, "#,0.0") & " tỷ"
			)
		displayFolder: 08 Display
		lineageTag: 38e0c45f-774d-4b9a-9dfa-63fad4b6e225

	measure 'Ctx Achieve' =
			VAR g = [Gap to Target]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(g), "Không có chỉ tiêu trong phạm vi",
			        g >= 0, "Vượt " & FORMAT(g / 1e9, "#,0.0") & " tỷ",
			        "Còn thiếu " & FORMAT(-g / 1e9, "#,0.0") & " tỷ để đạt"
			    )
		displayFolder: 08 Display
		lineageTag: feb30449-b5de-4f64-8d99-a8bb64b06625

	/// Giá trị thẻ dự báo: số dự báo (tỷ) hoặc "Kỳ đã đóng"
	measure 'Forecast Display' =
			VAR f = [Forecast Period End]
			RETURN IF(ISBLANK(f), "Kỳ đã đóng", FORMAT(f / 1e9, "#,0.0") & " tỷ")
		displayFolder: 08 Display
		lineageTag: 8229acd4-2a24-456d-93b5-9fd4d19d5e43

	measure 'Ctx Forecast' =
			IF(
			    ISBLANK([Forecast Period End]),
			    "Dữ liệu tới " & FORMAT([Last Data Date], "dd/mm/yyyy") & ", không cần dự báo",
			    "Dự báo đạt " & FORMAT([Forecast Achieve %], "0.0%") & " chỉ tiêu · " & [Forecast Status]
			)
		displayFolder: 08 Display
		lineageTag: d8dcfc61-6c5c-474c-8279-392c279b9a45

	measure 'Ctx Returns' = "Tỷ lệ trả " & FORMAT([Return Rate %], "0.0%") & " · " & FORMAT([Returns Qty] + 0, "#,0") & " sản phẩm"
		displayFolder: 08 Display
		lineageTag: 3fb4f62b-1c87-47d7-8ee5-6dc5c6f995aa

	measure 'Ctx Active Customers' = "Mới " & FORMAT([New Customers] + 0, "#,0") & " · quay lại " & FORMAT([Returning Customers] + 0, "#,0")
		displayFolder: 08 Display
		lineageTag: 132f54a5-8599-4dc1-a040-d2ef42644d34

	measure 'Ctx Trend' = "3 tháng gần nhất " & FORMAT([Net Revenue L3M] / 1e9, "#,0.0") & " tỷ, 3 tháng trước " & FORMAT([Net Revenue P3M] / 1e9, "#,0.0") & " tỷ"
		displayFolder: 08 Display
		lineageTag: eeb5747f-df03-4487-8aa9-079212710d6e

	measure 'Title KPI Trend' =
			VAR a = [Achieve %]
			RETURN
			    IF(
			        ISBLANK(a),
			        "Doanh thu thuần theo tháng (chỉ tiêu không áp dụng cho phạm vi này)",
			        "Thực tế đạt " & FORMAT(a, "0.0%") & " chỉ tiêu: " & FORMAT([Net Revenue] / 1e9, "#,0.0") & " / " & FORMAT([Target (Latest)] / 1e9, "#,0.0") & " tỷ"
			    )
		displayFolder: 08 Display
		lineageTag: 7a02f393-e0f3-424f-94b9-c27f6f06af54

	measure 'Title Region Achieve' =
			VAR t =
			    FILTER(
			        ADDCOLUMNS(FILTER(VALUES('Dim Employee'[region]), NOT ISBLANK('Dim Employee'[region])), "@a", [Achieve %]),
			        NOT ISBLANK([@a])
			    )
			VAR hi = TOPN(1, t, [@a], DESC)
			VAR lo = TOPN(1, t, [@a], ASC)
			RETURN
			    IF(
			        COUNTROWS(t) < 2,
			        "% hoàn thành theo vùng",
			        "Cao nhất " & MAXX(hi, 'Dim Employee'[region]) & " " & FORMAT(MAXX(hi, [@a]), "0.0%")
			            & " · thấp nhất " & MAXX(lo, 'Dim Employee'[region]) & " " & FORMAT(MAXX(lo, [@a]), "0.0%")
			    )
		displayFolder: 08 Display
		lineageTag: d80dcb94-6ba4-49aa-ac20-409f4c3f4573

	measure 'Title KPI Matrix' =
			VAR t = FILTER(ADDCOLUMNS(VALUES('Dim Employee'[employee_id]), "@a", [Achieve %]), NOT ISBLANK([@a]))
			RETURN
			    IF(
			        COUNTROWS(t) = 0,
			        "Kết quả theo vùng, nhóm, nhân viên",
			        FORMAT(COUNTROWS(FILTER(t, [@a] >= 1)) + 0, "#,0") & "/" & FORMAT(COUNTROWS(t), "#,0") & " nhân viên đạt chỉ tiêu"
			    )
		displayFolder: 08 Display
		lineageTag: 84db19cd-a531-45f8-aba0-a2defb368692

	measure 'Title Version Compare' =
			IF(
			    ISBLANK([Achieve %]),
			    "Thực tế so với từng phiên bản kế hoạch",
			    "So kế hoạch đầu năm đạt " & FORMAT([Achieve % (Original)], "0.0%") & " · so bản đang áp dụng " & FORMAT([Achieve %], "0.0%")
			)
		displayFolder: 08 Display
		lineageTag: a151c89a-804e-45a6-9029-b0bdc5dfdae6

	measure 'Title Top Customers' =
			VAR n = [Top N Value]
			VAR t = FILTER(ADDCOLUMNS(VALUES('Dim Customer'[customer_name]), "@r", [Net Revenue]), NOT ISBLANK([@r]))
			VAR topRows = TOPN(n, t, [@r], DESC)
			RETURN "Top " & n & " khách hàng chiếm " & FORMAT(DIVIDE(SUMX(topRows, [@r]), [Net Revenue]), "0.0%") & " doanh thu thuần"
		displayFolder: 08 Display
		lineageTag: f67b08da-2bd7-4fcc-86e9-1fb5ab1e4f63

	measure 'Title Customer Lifecycle' = "Trong kỳ: " & FORMAT([New Customers] + 0, "#,0") & " KH mới · " & FORMAT([Returning Customers] + 0, "#,0") & " quay lại · " & FORMAT([Churned Customers] + 0, "#,0") & " rời bỏ (90 ngày)"
		displayFolder: 08 Display
		lineageTag: b3d39df9-9e48-4a8b-a4fc-70a03e97eda1

	measure 'Title Trend Ranking' =
			VAR t = FILTER(ADDCOLUMNS(VALUES('Dim Employee'[employee_id]), "@g", [Net Revenue Trend %]), NOT ISBLANK([@g]))
			RETURN
			    FORMAT(COUNTROWS(FILTER(t, [@g] > 0)) + 0, "#,0") & " nhân viên tăng, " & FORMAT(COUNTROWS(FILTER(t, [@g] < 0)) + 0, "#,0")
			        & " nhân viên giảm so với 3 tháng trước"
		displayFolder: 08 Display
		lineageTag: d201e0f3-08c9-4399-804e-d651c0a13ee3

	measure 'Title Channel Mix' =
			VAR t = ADDCOLUMNS(FILTER(VALUES('Dim Distributor'[channel]), NOT ISBLANK('Dim Distributor'[channel])), "@v", [Distributor Order Value])
			VAR topRow = TOPN(1, t, [@v], DESC)
			RETURN
			    IF(
			        ISBLANK([Distributor Order Value]),
			        "Channel mix",
			        "Kênh lớn nhất: " & MAXX(topRow, 'Dim Distributor'[channel]) & " (" & FORMAT(DIVIDE(MAXX(topRow, [@v]), [Distributor Order Value]), "0.0%") & " giá trị đơn)"
			    )
		displayFolder: 08 Display
		lineageTag: 33ee8350-ad60-4162-8066-d5ac1c6fabfa

	measure 'Title Declining Distributors' =
			VAR t = FILTER(ADDCOLUMNS(VALUES('Dim Distributor'[distributor_id]), "@g", [Distributor Trend %]), NOT ISBLANK([@g]))
			RETURN FORMAT(COUNTROWS(FILTER(t, [@g] < 0)) + 0, "#,0") & "/" & FORMAT(COUNTROWS(t) + 0, "#,0") & " NPP giảm so với 3 tháng trước"
		displayFolder: 08 Display
		lineageTag: ca3a9435-f5e8-4a1e-9d61-247901592e22

	measure 'Title Inactive Distributors' = "⚠ " & FORMAT([Inactive Distributors] + 0, "#,0") & " NPP quá 30 ngày chưa đặt hàng"
		displayFolder: 08 Display
		lineageTag: c431135b-08e1-4bdd-b433-32f0a7b09b00

	measure 'Title Distributor Trend' =
			IF(
			    ISBLANK([Fill Rate %]),
			    "Giá trị đặt, giao và fill rate theo tháng",
			    "Fill rate " & FORMAT([Fill Rate %], "0.0%") & " · giao đúng hạn " & FORMAT([On-time %], "0.0%")
			)
		displayFolder: 08 Display
		lineageTag: ab4e6e27-9178-4248-b8d3-37bec38d32cb

	column _
		isHidden
		lineageTag: e403a7dc-7a12-4fdb-8659-49a8c4d598e0
		isNameInferred
		sourceColumn: [_]

	partition _Measures = calculated
		mode: import
		source = ROW("_", BLANK())

