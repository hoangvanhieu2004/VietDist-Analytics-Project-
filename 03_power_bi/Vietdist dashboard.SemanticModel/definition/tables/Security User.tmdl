/// Tra cứu RLS: user (email) → employee_id / region / team theo bản ghi current. Không có quan hệ nên không bị RLS lọc.
table 'Security User'
	isHidden
	lineageTag: 2a99227e-e674-4eff-9f74-51889997e56f

	column email
		lineageTag: 7fdffcd8-c098-4025-a72d-209de29ac602
		isNameInferred
		sourceColumn: [email]

	column employee_id
		lineageTag: 694768f3-f898-49f2-9c5d-f9e42d81b527
		isNameInferred
		sourceColumn: [employee_id]

	column position
		lineageTag: e79eea52-4ff4-42b5-bf7e-9470b8ae88ab
		isNameInferred
		sourceColumn: [position]

	column region
		lineageTag: 3f560005-ecef-4668-bb5a-59b248c40478
		isNameInferred
		sourceColumn: [region]

	column team
		lineageTag: 49f3c03f-a3a4-425a-a421-edf1c6784c8a
		isNameInferred
		sourceColumn: [team]

	partition 'Security User' = calculated
		mode: import
		source =
				SELECTCOLUMNS(
				    FILTER('Dim Employee', 'Dim Employee'[is_current] = TRUE() && NOT ISBLANK('Dim Employee'[email])),
				    "email", LOWER('Dim Employee'[email]),
				    "employee_id", 'Dim Employee'[employee_id],
				    "position", 'Dim Employee'[position],
				    "region", 'Dim Employee'[region],
				    "team", 'Dim Employee'[team]
				)

