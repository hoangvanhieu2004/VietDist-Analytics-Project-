/// Bảng rời để chọn phiên bản kế hoạch (BR-A-02). Không có quan hệ; measure dùng TREATAS.
table 'Plan Version'
	lineageTag: 2a64d4af-5639-4e84-a5db-f328f7358b25

	column version_code
		lineageTag: 6488a118-6792-4ed6-acb0-5136886dc33c
		isNameInferred
		sourceColumn: [version_code]
		sortByColumn: version_number

	column version_number
		lineageTag: fe16f07e-1835-4dda-a858-b96bd9443316
		summarizeBy: none
		isNameInferred
		sourceColumn: [version_number]

	partition 'Plan Version' = calculated
		mode: import
		source = DISTINCT(SELECTCOLUMNS('Fact Targets', "version_code", 'Fact Targets'[version_code], "version_number", 'Fact Targets'[version_number]))

